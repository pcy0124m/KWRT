# LEDE config - JDCloud RE-SP-01B (MT7621) - 精简版
# 设备闪存上限 27328k (约26.7MB)
# 注意: lede 源不含 iStore(luci-app-store), 需要 iStore 请用 KWRT-build.yml

# ---------- 目标平台 (lede 格式, 不需要 MULTI_PROFILE) ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

# ---------- 固件格式 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=104
CONFIG_TARGET_IMAGES_GZIP=y

# ---------- 无线驱动（必须） ----------
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y

# ---------- USB 存储（基础 ext4） ----------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-tun=y

# ---------- 基础工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_unzip=y

# ---------- 网络加速（软件流卸载） ----------
CONFIG_PACKAGE_luci-app-turboacc=y

# ---------- WireGuard ----------
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ---------- Argon 主题（diy.sh 已添加源） ----------
CONFIG_PACKAGE_luci-theme-argon=y
